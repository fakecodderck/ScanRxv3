{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access control (Admin, Company, Distributor, Pharmacy)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["admin", "company", "distributor", "pharmacy"]
        },
        "organization": { "type": "string" },
        "facilityLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "facilityName": { "type": "string" },
            "city": { "type": "string" },
            "country": { "type": "string" }
          }
        },
        "status": {
          "type": "string",
          "enum": ["active", "pending_approval", "suspended"]
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "organization"]
    },
    "MedicineBatch": {
      "title": "MedicineBatch",
      "description": "Pharmaceutical batch record minted by a registered pharmaceutical company",
      "type": "object",
      "properties": {
        "batchNumber": { "type": "string" },
        "drugName": { "type": "string" },
        "genericName": { "type": "string" },
        "companyId": { "type": "string" },
        "manufacturer": { "type": "string" },
        "dosageForm": { "type": "string" },
        "ndcCode": { "type": "string" },
        "mfgLicenseNo": { "type": "string" },
        "mrpInr": { "type": "number" },
        "totalPacks": { "type": "number" },
        "merkleRoot": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["active", "recalled", "quarantined"]
        },
        "temperatureSpec": {
          "type": "object",
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "unit": { "type": "string" }
          }
        },
        "mfgDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "creationTxHash": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["batchNumber", "drugName", "companyId", "merkleRoot", "status"]
    },
    "ShippingInvoice": {
      "title": "ShippingInvoice",
      "description": "Commercial GST shipping invoice generated by manufacturer for distributors & stockists",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "companyId": { "type": "string" },
        "companyName": { "type": "string" },
        "distributorId": { "type": "string" },
        "distributorName": { "type": "string" },
        "batchNumber": { "type": "string" },
        "drugName": { "type": "string" },
        "packQuantity": { "type": "number" },
        "unitPriceInr": { "type": "number" },
        "totalAmountInr": { "type": "number" },
        "gstPercentage": { "type": "number" },
        "gstAmountInr": { "type": "number" },
        "grandTotalInr": { "type": "number" },
        "dispatchDate": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["dispatched", "in_transit", "delivered_confirmed", "disputed"]
        },
        "temperatureReading": { "type": "number" },
        "deliveryConfirmation": {
          "type": "object",
          "properties": {
            "confirmedBy": { "type": "string" },
            "confirmedAt": { "type": "number" },
            "signature": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "timestamp": { "type": "number" }
      },
      "required": ["invoiceNumber", "companyId", "batchNumber", "distributorName", "status"]
    },
    "SecurityAlert": {
      "title": "SecurityAlert",
      "description": "Counterfeit and impossible travel security breach report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "severity": { "type": "string", "enum": ["critical", "high", "medium"] },
        "alertType": { "type": "string" },
        "timestamp": { "type": "number" },
        "packId": { "type": "string" },
        "batchNumber": { "type": "string" },
        "drugName": { "type": "string" },
        "details": { "type": "string" },
        "calculatedVelocityKmH": { "type": "number" },
        "resolved": { "type": "boolean" },
        "resolutionNote": { "type": "string" }
      },
      "required": ["id", "severity", "alertType", "timestamp", "details"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile records including role assignment"
    },
    "/batches/{batchId}": {
      "schema": "MedicineBatch",
      "description": "Master pharmaceutical batch records and Merkle roots"
    },
    "/invoices/{invoiceId}": {
      "schema": "ShippingInvoice",
      "description": "Shipping invoices linking companies and distributors"
    },
    "/alerts/{alertId}": {
      "schema": "SecurityAlert",
      "description": "Counterfeit and impossible travel security alerts"
    }
  }
}
