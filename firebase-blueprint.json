{
  "entities": {
    "MedicineBatch": {
      "title": "MedicineBatch",
      "description": "Pharmaceutical production batch registered on CDSCO ledger",
      "type": "object",
      "properties": {
        "batchNumber": { "type": "string" },
        "drugName": { "type": "string" },
        "genericName": { "type": "string" },
        "manufacturer": { "type": "string" },
        "dosageForm": { "type": "string" },
        "ndcCode": { "type": "string" },
        "mfgLicenseNo": { "type": "string" },
        "mrpInr": { "type": "number" },
        "mfgDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "totalPacks": { "type": "number" },
        "merkleRoot": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "recalled", "quarantined", "blocked"] },
        "creationTxHash": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["batchNumber", "drugName", "manufacturer", "status", "timestamp"]
    },
    "MedicinePack": {
      "title": "MedicinePack",
      "description": "Individual serialized medicine blister pack or carton",
      "type": "object",
      "properties": {
        "packId": { "type": "string" },
        "batchNumber": { "type": "string" },
        "serialNumber": { "type": "string" },
        "secureToken": { "type": "string" },
        "tokenHash": { "type": "string" },
        "merkleLeafIndex": { "type": "number" },
        "status": { "type": "string" },
        "currentHolder": { "type": "string" },
        "manufactureDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "opticalSecurityPatternEnrolled": { "type": "boolean" },
        "opticalPatternRef": { "type": "string" },
        "publicScanCount": { "type": "number" }
      },
      "required": ["packId", "batchNumber", "serialNumber", "secureToken", "status"]
    },
    "ScanLog": {
      "title": "ScanLog",
      "description": "Scan verification telemetry audit record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "packId": { "type": "string" },
        "batchNumber": { "type": "string" },
        "timestamp": { "type": "number" },
        "scanCategory": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "placeName": { "type": "string" },
        "ipAddress": { "type": "string" },
        "accuracy": { "type": "number" },
        "result": { "type": "string" },
        "verifiedOffline": { "type": "boolean" }
      },
      "required": ["id", "packId", "batchNumber", "timestamp", "result"]
    },
    "SecurityAlert": {
      "title": "SecurityAlert",
      "description": "Security anomaly and counterfeit risk alert",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "severity": { "type": "string" },
        "alertType": { "type": "string" },
        "timestamp": { "type": "number" },
        "packId": { "type": "string" },
        "batchNumber": { "type": "string" },
        "drugName": { "type": "string" },
        "details": { "type": "string" },
        "resolved": { "type": "boolean" }
      },
      "required": ["id", "severity", "alertType", "timestamp", "resolved"]
    },
    "ShippingInvoice": {
      "title": "ShippingInvoice",
      "description": "Manufacturer to distributor or pharmacy shipping consignment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "companyId": { "type": "string" },
        "companyName": { "type": "string" },
        "distributorName": { "type": "string" },
        "batchNumber": { "type": "string" },
        "drugName": { "type": "string" },
        "packQuantity": { "type": "number" },
        "grandTotalInr": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "invoiceNumber", "batchNumber", "packQuantity", "status"]
    },
    "RegisteredOrganization": {
      "title": "RegisteredOrganization",
      "description": "Approved or pending pharmaceutical organization registration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "contactEmail": { "type": "string" },
        "drugLicenseNo": { "type": "string" },
        "gstin": { "type": "string" },
        "appliedAt": { "type": "number" }
      },
      "required": ["id", "name", "type", "status", "drugLicenseNo"]
    }
  },
  "firestore": {
    "/batches/{batchNumber}": {
      "schema": { "$ref": "#/entities/MedicineBatch" },
      "description": "Registered pharmaceutical batches"
    },
    "/packs/{packId}": {
      "schema": { "$ref": "#/entities/MedicinePack" },
      "description": "Serialized medicine packs"
    },
    "/scanLogs/{scanId}": {
      "schema": { "$ref": "#/entities/ScanLog" },
      "description": "Consumer & pharmacy verification scan telemetry"
    },
    "/securityAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/SecurityAlert" },
      "description": "Security alerts and clone warnings"
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/ShippingInvoice" },
      "description": "B2B pharma shipping invoices"
    },
    "/organizations/{orgId}": {
      "schema": { "$ref": "#/entities/RegisteredOrganization" },
      "description": "Registered pharma entities"
    }
  }
}
